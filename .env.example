# Local configuration template for GScrape.
#
# Copy this file to .env and replace only values you are authorized to use.
# The .env file is ignored by Git. Never commit OAuth tokens, API keys, client
# secrets, mailbox data, wallet material, or recovery output.

# Google OAuth client identifier from Google Cloud Console. Usually ends in
# .apps.googleusercontent.com. Required for --authorize and for refreshing a
# Gmail access token; it is not itself a mailbox credential.
GOOGLE_CLIENT_ID=

# Google OAuth client secret paired with GOOGLE_CLIENT_ID. Required for local
# authorization and for exchanging GMAIL_REFRESH_TOKEN for a fresh token.
GOOGLE_CLIENT_SECRET=

# Long-lived OAuth refresh token for the authorized Gmail account. Leave blank
# until --authorize creates one. It must be an OAuth refresh token, not a
# Google API key or an email account password. Never commit this value.
GMAIL_REFRESH_TOKEN=

# Optional short-lived OAuth bearer access token for a direct scan. Access
# tokens expire; do not use a value beginning with AIza (Google API-key format).
# Prefer a refresh-token flow for repeatable scans and never commit this value.
GMAIL_ACCESS_TOKEN=

# Optional Google API key. It can identify a Google API project, but it does
# NOT authorize private Gmail access; OAuth is still required for mailbox data.
GOOGLE_API_KEY=

# Exact local OAuth callback URI registered on the Google Cloud OAuth client.
# The trailing slash and port must match exactly. Default: http://127.0.0.1:8765/
# Do not change this to a public or remote callback URL.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/

# Optional OpenAI-compatible analysis of redacted report metadata only. It is
# not used for Gmail authorization or ordinary searches. Never send message
# bodies, tokens, seeds, private keys, or attachment bytes.
OPENAI_API_KEY=

# HTTP(S) base URL for an OpenAI-compatible chat-completions API, commonly
# ending in /v1. Used only when LLM analysis is enabled or explicitly requested.
LLM_API_BASE=https://api.openai.com/v1

# Model identifier understood by LLM_API_BASE, such as gpt-4o-mini. It must be
# available from the configured provider and should support metadata analysis.
LLM_MODEL=gpt-4o-mini

# Dashboard automatic-analysis switch. Accepted true values are 1, true, yes,
# and on (case-insensitive). Blank, false, or any other value disables reports
# after completed dashboard runs. It does not affect normal deterministic scans
# or explicit --analyze-category usage.
GSCRAPE_LLM_ENABLED=false

# Name of the environment variable containing the LLM API key, not the key
# itself. OPENAI_API_KEY means the dashboard reads that variable. Change this
# only when the configured provider uses another secret variable name.
LLM_API_KEY_ENV=OPENAI_API_KEY

# Directory for automatic LLM reports. Relative paths are under the repository
# root; absolute paths are used as written. Keep reports private; default:
# llm-reports/.
LLM_OUTPUT_DIR=llm-reports

# Dashboard generated-result retention in whole days. Must be a non-negative
# integer such as 30, 7, or 0. The dashboard default is 30 days.
GSCRAPE_RETENTION_DAYS=30

# Finding sort preference. The documented value is relevance. This name is
# retained for configuration compatibility; use explicit CLI/dashboard sort
# controls when available.
GSCRAPE_SORT_FINDINGS=relevance

# Sensitive-evidence policy switch. Use true or false; keep true for the
# fail-closed default. This does not authorize capture or review of secrets.
GSCRAPE_SECRET_EVIDENCE_ENABLED=true

# Protected-artifact policy. Allowed names are metadata-only, capture-selected,
# and capture-high-confidence. metadata-only records non-secret metadata and is
# the current safe default. The current Gmail provider accepts metadata-only
# only and fails closed for capture modes without an enabled secure backend.
GSCRAPE_CAPTURE_MODE=metadata-only

# Directory for encrypted protected artifacts when an approved encrypted
# backend is enabled. Relative paths are under the repository root. Never use
# this for plaintext wallet exports or ordinary reports; default: protected-artifacts/.
GSCRAPE_ENCRYPTED_OUTPUT_DIR=protected-artifacts
