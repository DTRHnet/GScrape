# Copy to .env for local use; never commit .env or OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional: use only for authorized local Gmail API access.
GMAIL_ACCESS_TOKEN=
GOOGLE_API_KEY=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/
# Optional OpenAI-compatible analysis of redacted report metadata only.
OPENAI_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
GSCRAPE_LLM_ENABLED=false
LLM_API_KEY_ENV=OPENAI_API_KEY
LLM_OUTPUT_DIR=llm-reports

# Search and local protected-artifact settings.
GSCRAPE_SORT_FINDINGS=relevance
GSCRAPE_SECRET_EVIDENCE_ENABLED=true
GSCRAPE_CAPTURE_MODE=metadata-only
GSCRAPE_ENCRYPTED_OUTPUT_DIR=protected-artifacts
